# Environment
NODE_ENV=development

# GitHub Token (for CI/CD, optional)
# GIT_TOKEN=your_github_token_here

# Server
PORT=3000
CLIENT_PORT=3001

# Perplexity API (Required - 크롤링 대신 Perplexity Search API 사용)
# https://docs.perplexity.ai/api-reference/search-post
PERPLEXITY_API_KEY=pplx-your-api-key-here
PERPLEXITY_MODEL=pplx-7b-online

# AWS Settings
AWS_REGION=ap-northeast-2
# AWS_ACCESS_KEY_ID=your_key  # 프로덕션에서만 필요
# AWS_SECRET_ACCESS_KEY=your_secret  # 프로덕션에서만 필요

# DynamoDB (로컬 개발 시 Docker로 실행)
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_TABLE_SESSIONS=BlackCow_SearchSessions
DYNAMODB_TABLE_HISTORY=BlackCow_SearchHistory
DYNAMODB_TABLE_CACHE=BlackCow_AnalysisCache

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ================================
# 주요 변경사항
# ================================
# - 웹 크롤링 제거: 법적 이슈로 인해 직접 크롤링 대신 Perplexity Search API 사용
# - Perplexity API: 제품명 검색 기반 정보 수집 (가격, 리뷰, 플랫폼 등)
# - DynamoDB: 검색 세션 및 이력 저장
# - 제한사항:
#   * URL이 아닌 제품명(예: "아이폰17", "닌텐도 스위치2")을 입력받음
#   * 실시간 크롤링이 아닌 검색 결과 기반 분석
#   * 정확도는 Perplexity의 검색 품질에 의존

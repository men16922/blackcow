# Environment
NODE_ENV=development

# GitHub Token (for CI/CD, optional)
# GIT_TOKEN=your_github_token_here

# Server
PORT=3000
CLIENT_PORT=3001

# AI Provider (choose one: 'bedrock' or 'claude')
AI_PROVIDER=claude

# Claude API (recommended for local development)
CLAUDE_API_KEY=sk-ant-api03-your-key-here
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# AWS Bedrock (production)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_key
AWS_SECRET_ACCESS_KEY=your_secret
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-20250514-v1:0

# DynamoDB
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_TABLE_PREFIX=shopping-fraud-detector

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
